# loopy-jp 시크릿 — 복사해서 .env 로 저장하고 값 채우기. .env 는 커밋 금지(.gitignore).
# 코드 하드코딩 금지: 모든 키는 여기로만.

# --- LLM 트랜스크리에이션 / 메타데이터 (Anthropic Claude) ---
# engine/translate.py, src/metadata.py 가 사용. ANTHROPIC_API_KEY 로도 인식.
LLM_API_KEY=
# 모델 오버라이드(선택). 미지정 시 config/pipeline.config.yaml 의 translate.model 사용.
# LLM_MODEL=claude-sonnet-4-6

# --- 선택: DeepL 초벌 번역 ---
# translate.use_deepl_draft=true 또는 --deepl 일 때만 사용.
TRANSLATE_API_KEY=

# --- 선택: YouTube Data API ---
# 메타데이터 리서치/스케줄 보조용. ⚠ 자동 게시에는 쓰지 않는다(게시는 사람이).
YOUTUBE_API_KEY=

# --- 선택: 더빙 TTS (Level C 한정, src/dub.py) ---
ELEVENLABS_API_KEY=

# 인페인팅 모델은 로컬 실행 → 키 불필요(weights/ 에서 로드).
