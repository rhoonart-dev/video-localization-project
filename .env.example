# loopy-jp 시크릿 — 복사해서 .env 로 저장하고 값 채우기. .env 는 커밋 금지(.gitignore).
# 코드 하드코딩 금지: 모든 키는 여기로만.

# --- LLM 트랜스크리에이션 / 메타데이터 (기본: Gemini) ---
# engine/translate.py, src/metadata.py, src/thumbnail.py 가 사용.
# provider 는 config/pipeline.config.yaml 의 translate.provider (gemini|anthropic).
# LLM_API_KEY 우선, 프로바이더별 폴백(GEMINI_API_KEY/GOOGLE_API_KEY 또는 ANTHROPIC_API_KEY)도 인식.
LLM_API_KEY=
# GEMINI_API_KEY=
# 모델 오버라이드(선택). 미지정 시 config/pipeline.config.yaml 의 translate.model 사용.
# LLM_MODEL=gemini-3.5-flash

# --- 선택: DeepL 초벌 번역 ---
# translate.use_deepl_draft=true 또는 --deepl 일 때만 사용.
TRANSLATE_API_KEY=

# --- 선택: YouTube Data API ---
# 채널 스카우트(src/scout.py)·댓글 언어분석(src/autopilot.py score)용 공개 데이터 키.
# 없으면 scout 는 yt-dlp 폴백(근사 조회수, 댓글 신호 생략). ⚠ 자동 게시에는 쓰지 않는다.
YOUTUBE_API_KEY=

# --- 선택: YouTube 업로드 OAuth (scripts/yt_upload_test.py, 향후 자동 업로더) ---
# GCP 콘솔 → 사용자 인증 정보 → OAuth 클라이언트 ID(유형: TV 및 제한된 입력 장치)
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=

# --- 선택: autopilot Slack 알림 (src/notify.py) ---
# 일일 다이제스트·처리 완료/실패·승인 알림. 미설정 시 알림만 생략(파이프라인 정상 동작).
SLACK_WEBHOOK_URL=

# --- 선택: 더빙 TTS (Level C 한정, src/dub.py) ---
ELEVENLABS_API_KEY=

# --- 선택: ffmpeg 바이너리 지정 (engine/common.py ffmpeg_bin/ffprobe_bin) ---
# PATH 의 ffmpeg 가 libass 없이 빌드된 머신(예: homebrew ffmpeg 8)은 ass 필터가 없어
# 자막·텔롭 번인이 실패한다 → libass 포함 빌드를 지정. ffprobe 는 형제 경로에서 자동 추론.
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg@7/bin/ffmpeg
# FFPROBE_BIN=   # FFMPEG_BIN 형제와 다른 곳에 있을 때만

# 인페인팅 모델은 로컬 실행 → 키 불필요(weights/ 에서 로드).
