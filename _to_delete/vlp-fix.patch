+  # ⚠ voice_id 는 이 블록 위쪽(tts_backend 바로 아래)에 하나만 둔다. 여기 있던
+  #   `voice_id: null` 을 지웠다 — YAML 중복 키는 뒤엣것이 이겨서, 2026-08-13 elevenlabs
+  #   전환 커밋이 넣은 IVC voice_id 를 이 null 이 덮고 있었다. 그대로 두면 첫 합성에서
+  #   dub.py: `ValueError: elevenlabs 백엔드: voice_id 필요` 로 죽는다.
   tts_model: eleven_multilingual_v2
 
 select:
@@ -229,6 +236,9 @@ autopilot:                         # Phase 1: 후보 선별 봇 — 업로드 
   require_llm: true                # LLM 전면 실패 시 실행 중단(열화 점수 고착 방지). false=정량만
